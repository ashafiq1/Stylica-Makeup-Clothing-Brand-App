<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Search products..."
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_input_field"
            android:textSize="14sp"
            android:textColor="#1A1A2E"
            android:textColorHint="#BDBDBD" />

    </LinearLayout>

    <!-- Category Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:scrollbars="none"
        android:paddingBottom="12dp"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipMakeup"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="&#128132; Makeup"
                android:textSize="13sp"
                android:textColor="#757575"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipClothing"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="&#128248; Clothing"
                android:textSize="13sp"
                android:textColor="#757575"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipAccessories"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="&#128144; Accessories"
                android:textSize="13sp"
                android:textColor="#757575"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipShoes"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="&#128094; Shoes"
                android:textSize="13sp"
                android:textColor="#757575"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipSale"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="&#128293; Sale 50% OFF"
                android:textSize="13sp"
                android:textColor="#757575"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Products Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
